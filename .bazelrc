# Core repo behavior
build --incompatible_disallow_empty_glob=false

# Windows-native defaults for the layered runtime and CI graph.
common --enable_bzlmod
build:windows --repo_env=BAZEL_SH=C:/Program Files/Git/bin/bash.exe
build:windows --cpu=x64_windows
build:windows --copt=/std:c++17
build:windows --cxxopt=/std:c++17
build:windows --features=compiler_param_file
build:windows --test_output=errors

# Opt-in remote-cache workflow for incremental validation and CI.
build:remote --remote_cache=grpc://127.0.0.1:9092
build:remote --remote_upload_local_results=true
build:remote --remote_timeout=60
