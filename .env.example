# Generate a unique key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Store the actual value in your deployment secret manager, not in Git.
SANCTUM_API_KEY=

# Optional provider-neutral OIDC authentication. Both settings are required
# together; the configured issuer must use HTTPS and publish discovery/JWKS.
# Access tokens must include the configured audience, subject, exp, iat,
# `roles` (ADMIN/AUDITOR/VIEWER), and `tenant_id` claims.
# SANCTUM_OIDC_ISSUER=https://identity.example.com/
# SANCTUM_OIDC_AUDIENCE=sanctum-api
# SANCTUM_OIDC_ROLES_CLAIM=roles
# SANCTUM_OIDC_TENANT_CLAIM=tenant_id
# OIDC tenant data is stored in separate SQLite files under this directory.
# SANCTUM_TENANT_DATA_DIR=C:\path\to\sanctum-tenants
# Legacy shared API-key auth is disabled when OIDC is enabled unless explicitly
# opted in. Legacy API-key requests are not tenant-isolated.
# SANCTUM_ALLOW_LEGACY_API_KEY=false

# TLS is required when `sanctum serve` binds to a non-loopback address.
# Keep the private key in a deployment secret manager; do not commit it.
# SANCTUM_TLS_CERT_FILE=C:\path\to\tls-cert.pem
# SANCTUM_TLS_KEY_FILE=C:\path\to\tls-key.pem
# Alternatively, explicitly approve plain HTTP only behind an externally
# TLS-terminating proxy with network ingress restricted to that proxy.
# SANCTUM_TRUST_TLS_TERMINATION_PROXY=false

# Optional persistent SQLite store for control assessments and evidence references.
# Mount a durable, access-restricted volume in deployments.
# SANCTUM_CONTROLS_DB=C:\path\to\sanctum-controls.sqlite3

# Persistent SQLite store for incident cases, notes, and evidence references.
# Mount a durable, access-restricted volume in deployments.
# SANCTUM_CASES_DB=C:\path\to\sanctum-cases.sqlite3

# Optional automatic retention for resolved/closed cases and access audit records.
# Unset values disable automatic deletion. Values must be 1-36500 days.
# Case deletion cascades to timeline, notes, evidence references, and playbooks.
# SANCTUM_CASE_RETENTION_DAYS=
# SANCTUM_ACCESS_AUDIT_RETENTION_DAYS=

# Required before persistent telemetry ingestion is enabled.
# Configure per-source secrets (at least 32 bytes each) in the deployment secret
# manager as a JSON object; never expose source keys to browser clients.
# SANCTUM_EVENT_SOURCE_KEYS={"identity-provider":"replace-with-a-strong-secret"}
# Required when OIDC is enabled: bind each push source credential to one tenant.
# SANCTUM_EVENT_SOURCE_TENANTS={"identity-provider":"tenant-a"}
# Retention is required and has no default; values must be 1-36500 days.
# SANCTUM_EVENT_RETENTION_DAYS=
# Limits telemetry re-correlation to recently ingested events; 1-720 hours.
# SANCTUM_EVENT_CORRELATION_WINDOW_HOURS=24

# Optional exact browser origins for dashboard access to the protected API.
# Never use a wildcard. Leave empty when browser-based cross-origin access is not needed.
# SANCTUM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Exact comma-separated target allowlist for active endpoint/port checks.
# Empty means active scans are denied. Do not use wildcards.
SANCTUM_AUTHORIZED_TARGETS=

# Signed Ed25519 entitlement. Keep tokens and private signing keys in a secret manager.
SANCTUM_LICENSE_KEY=
SANCTUM_LICENSE_PUBLIC_KEY=

# Optional generic CEF webhook; configure an operator-approved HTTPS endpoint.
# The token is sent as a Bearer credential and must remain server-side.
# SANCTUM_SIEM_WEBHOOK_URL=
# SANCTUM_SIEM_WEBHOOK_TOKEN=

# Persistent quota database; mount a durable, access-restricted volume in deployments.
# SANCTUM_BILLING_DB=C:\path\to\sanctum-usage.sqlite3
