# Full WebSocket URL of the authorized SANCTUM API.
# Example for local development:
NEXT_PUBLIC_SANCTUM_WS_URL=ws://127.0.0.1:8000/ws/incidents

# Lead form backend. Keep these server-side values out of NEXT_PUBLIC_* variables.
# The form returns 503 until an HTTPS webhook is configured.
SANCTUM_LEAD_WEBHOOK_URL=
SANCTUM_LEAD_WEBHOOK_TOKEN=
