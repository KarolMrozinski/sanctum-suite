with "config/sanctum_suite_config.gpr";
project Sanctum_Suite is

   for Source_Dirs use ("src/", "c_src", "config/");
   for Object_Dir use "obj/" & Sanctum_Suite_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("sanctum_suite.adb");
   for Languages use ("Ada", "C");

   package Compiler is
      for Default_Switches ("Ada") use Sanctum_Suite_Config.Ada_Compiler_Switches;
      for Default_Switches ("Ada") use ("-gnatWb", "-gnaty", "-g");
      for Default_Switches ("C") use ("-O2", "-Wall");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Builder is
      for Default_Switches ("Ada") use ("-g");
   end Builder;
   
   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Sanctum_Suite;
