load("@rules_cc//cc:defs.bzl", "cc_test")

filegroup(
    name = "all_files",
    srcs = glob(
        ["**/*"],
        exclude = [
            "**/.git/**",
            "**/.bin/**",
            "**/bazel-*/**",
            "**/target/**",
            "**/node_modules/**",
            "**/.pytest_cache/**",
            "**/.vscode/**",
            "**/.idea/**",
            "**/.venv/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

cc_test(
    name = "workspace_smoke_test",
    srcs = ["tools/workspace_smoke_test.cc"],
    size = "small",
    copts = select({
        "@bazel_tools//tools/cpp:msvc": ["/std:c++17"],
        "//conditions:default": ["-std=c++17"],
    }),
)
