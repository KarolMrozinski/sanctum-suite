filegroup(
    name = "all_files",
    srcs = glob(
        ["**/*"],
        exclude = [
            "**/.git/**",
            "**/.bin/**",
            "**/bazel-*/**",
            "**/target/**",
            "**/node_modules/**",
            "**/.pytest_cache/**",
            "**/.vscode/**",
            "**/.idea/**",
            "**/.venv/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
