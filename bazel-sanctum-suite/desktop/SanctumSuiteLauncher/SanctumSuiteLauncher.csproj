<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\resources\sanctum-suite-icon.ico</ApplicationIcon>
    <RootNamespace>SanctumSuiteLauncher</RootNamespace>
    <AssemblyName>SanctumSuiteLauncher</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Company>KarolMrozinski</Company>
    <Product>Sanctum Suite</Product>
    <Description>Sanctum Suite desktop launcher and runtime shell for the CTI dashboard.</Description>
    <Copyright>Copyright © KarolMrozinski</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\resources\sanctum-suite-icon.ico" Link="sanctum-suite-icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
