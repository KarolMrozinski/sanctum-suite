<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="Sanctum Suite"
    Language="1033"
    Version="1.0.0.0"
    Manufacturer="Karol Mrozinski"
    UpgradeCode="{D3A03B09-778F-4F20-B18E-A8B011A40C3B}">
    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="Sanctum Suite CTI workspace installer"
      Comments="Protected Windows installation for the Sanctum Suite CTI dashboard and launcher."
      Manufacturer="Karol Mrozinski" />

    <MediaTemplate CompressionLevel="high" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <UIRef Id="WixUI_InstallDir" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Sanctum Suite" />
      </Directory>
    </Directory>

    <Feature Id="ProductFeature" Title="Sanctum Suite" Level="1">
      <ComponentRef Id="AppShortcut" />
    </Feature>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="AppShortcut" Guid="{4EFA49D2-0B1D-4805-8371-7522D7AB01C7}">
        <Shortcut Id="SanctumSuiteShortcut"
                  Name="Sanctum Suite"
                  Target="[INSTALLDIR]SanctumSuiteLauncher.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="SanctumSuiteIcon.exe" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Sanctum Suite" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Icon Id="SanctumSuiteIcon.exe" SourceFile="..\..\resources\sanctum-suite-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="SanctumSuiteIcon.exe" />
  </Product>
</Wix>
