<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\sanctum-suite-icon.ico</ApplicationIcon>
    <RootNamespace>SanctumSuiteLauncher</RootNamespace>
    <AssemblyName>SanctumSuiteLauncher</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\sanctum-suite-icon.ico" Link="sanctum-suite-icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
