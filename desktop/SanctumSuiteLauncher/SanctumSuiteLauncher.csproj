<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\resources\sanctum-suite-icon.ico</ApplicationIcon>
    <RootNamespace>SanctumSuiteLauncher</RootNamespace>
    <AssemblyName>SanctumSuiteLauncher</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\resources\sanctum-suite-icon.ico" Link="sanctum-suite-icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
